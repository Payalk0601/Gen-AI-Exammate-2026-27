# Copy this file to .env and fill in a key. .env is git-ignored and must never be committed.
GROQ_API_KEY=
GEMINI_API_KEY=

# Optional
LLM_PROVIDER=groq
GROQ_MODEL=llama-3.3-70b-versatile
GEMINI_MODEL=gemini-2.5-flash

# extractive = no LLM, answer sentences are copied from the sources; llm = use the provider; auto = llm if a key exists
KACHRACHECK_GENERATOR=auto
